# Run npm run setup to generate real credentials. Never commit .env.
VAULT_ENCRYPTION_KEY=base64-encoded-32-byte-key
ADMIN_TOKEN=generate-a-long-random-admin-token
AGENT_TOKEN=generate-a-separate-long-random-agent-token
HOST=127.0.0.1
PORT=3000
# Set to your public HTTPS URL when deploying behind a reverse proxy.
APP_ORIGIN=http://localhost:3000
SECURE_COOKIE=false
DATA_DIR=./data
